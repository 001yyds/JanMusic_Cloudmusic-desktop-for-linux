# Maintainer: jvvoch <jvvoch@localhost>
pkgname=betterncm
pkgver=1.7.0
pkgrel=1
pkgdesc="网易云音乐桌面客户端"
arch=('x86_64')
url="https://github.com/001yyds/Better_NCM_Linux"
license=('MIT')
depends=(
  'gtk3'
  'nss'
  'alsa-lib'
  'libxss'
  'libxtst'
  'xdg-utils'
  'at-spi2-core'
  'util-linux'
  'libsecret'
  'libnotify'
  'python'
  'python-gobject'
  'gtk3'
  'gtk-layer-shell'
  'libcups'
  'libdrm'
  'mesa'
  'libxkbcommon'
  'libxcomposite'
  'libxdamage'
  'libxrandr'
  'pango'
  'cairo'
  'gdk-pixbuf2'
  'nspr'
  'libx11'
  'libxcb'
)
options=('!strip' '!debug')
source=()
sha256sums=()

package() {
  local src="$startdir/../../release/linux-unpacked"

  install -d "$pkgdir/opt/betterncm"
  cp -a "$src/." "$pkgdir/opt/betterncm/"
  chmod 4755 "$pkgdir/opt/betterncm/chrome-sandbox"

  install -d "$pkgdir/usr/bin"
  ln -s /opt/betterncm/betterncm "$pkgdir/usr/bin/betterncm"

  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/betterncm.desktop" <<'EOF'
[Desktop Entry]
Name=BetterNCM
Comment=网易云音乐桌面客户端
Comment[zh_CN]=网易云音乐桌面客户端
Exec=betterncm %U
Icon=betterncm
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Player;
Keywords=music;netease;player;
StartupWMClass=betterncm
EOF

  install -Dm644 "$startdir/../icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/betterncm.png"
}
